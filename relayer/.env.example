# RPC endpoint (Base Sepolia or local Hardhat)
RPC_URL=https://base-sepolia.g.alchemy.com/v2/your-key

# Private key of the relayer wallet (0x...) used to call markVerified
RELAYER_PRIVATE_KEY=0x...

# Optional: override deployment JSON (defaults to ../deployments/baseSepolia-latest.json)
DEPLOYMENT_FILE=../deployments/baseSepolia-latest.json

# Set to "local" to run against Hardhat localhost
NETWORK=baseSepolia

# Starting block for log replay (optional)
FROM_BLOCK=

# zkVerify API configuration (adjust to match live endpoints)
ZKVERIFY_API_URL=https://api.zkverify.io/v0
ZKVERIFY_API_KEY=your-api-key
ZKVERIFY_PROGRAM_ID=demographic-program-id
ZKVERIFY_POLL_INTERVAL_MS=15000
ZKVERIFY_MAX_ATTEMPTS=20
